# Public build-time settings. These values are visible in the browser bundle.
VITE_SITE_NAME=Binary Minds
VITE_SITE_HOUSE=Kaziranga House
VITE_BRAND_LOGO=/binary-minds-logo.jpg
VITE_SANITY_PROJECT_ID=pirhl038
VITE_SANITY_DATASET=production
# Optional JSON array of public social links.
VITE_SOCIALS=
# Optional public endpoint URL. This URL is not a secret.
VITE_IDEATHON_SUBMISSION_API_URL=

# Server-only configuration for the protected admin portal. Never add VITE_ here.
SESSION_SECRET=
ADMIN_USERS_JSON=[]
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Must be the same project as VITE_SANITY_PROJECT_ID, and the write token must
# belong to it. Otherwise the admin saves to one project while the site reads
# another (the dev server and the admin both warn when they differ).
SANITY_PROJECT_ID=pirhl038
SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=
GOOGLE_APPS_SCRIPT_EMAIL_URL=
GOOGLE_APPS_SCRIPT_EMAIL_SECRET=
